    "components": {
        "schemas": {
            "EditarClienteRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "nome": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 8
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "cpf": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\d{11}$"
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date"
                    },
                    "endereco": {
                        "$ref": "#/components/schemas/EditarEnderecoRequest"
                    }
                },
                "required": [
                    "cpf",
                    "dataNascimento",
                    "email",
                    "endereco",
                    "id",
                    "nome"
                ]
            },
            "EditarEnderecoRequest": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "logradouro": {
                        "type": "string",
                        "minLength": 1
                    },
                    "complemento": {
                        "type": "string"
                    },
                    "numero": {
                        "type": "string",
                        "minLength": 1
                    },
                    "bairro": {
                        "type": "string",
                        "minLength": 1
                    },
                    "cidade": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uf": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z]{2}$"
                    },
                    "cep": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\d{8}$"
                    }
                },
                "required": [
                    "bairro",
                    "cep",
                    "cidade",
                    "logradouro",
                    "numero",
                    "uf"
                ]
            },
            "CriarClienteRequest": {
                "type": "object",
                "properties": {
                    "nome": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 8
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "minLength": 1
                    },
                    "cpf": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\d{11}$"
                    },
                    "dataNascimento": {
                        "type": "string",
                        "format": "date"
                    },
                    "endereco": {
                        "$ref": "#/components/schemas/EnderecoRequest"
                    }
                },
                "required": [
                    "cpf",
                    "dataNascimento",
                    "email",
                    "endereco",
                    "nome"
                ]
            },
            "EnderecoRequest": {
                "type": "object",
                "properties": {
                    "logradouro": {
                        "type": "string",
                        "minLength": 1
                    },
                    "complemento": {
                        "type": "string"
                    },
                    "numero": {
                        "type": "string",
                        "minLength": 1
                    },
                    "bairro": {
                        "type": "string",
                        "minLength": 1
                    },
                    "cidade": {
                        "type": "string",
                        "minLength": 1
                    },
                    "uf": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[A-Za-z]{2}$"
                    },
                    "cep": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^\\d{8}$"
                    }
                },
                "required": [
                    "bairro",
                    "cep",
                    "cidade",
                    "logradouro",
                    "numero",
                    "uf"
                ]
            }
        }
    }
